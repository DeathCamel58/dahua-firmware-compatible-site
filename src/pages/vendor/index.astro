---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import VendorLogo from "@/components/VendorLogo.astro";
import { getData, lastmodOf, paths } from "@/lib/data";
import { plural } from "@/lib/site";

const data = await getData();
const vendors = [...data.vendors.values()].sort((a, b) => b.firmwares.length - a.firmwares.length || a.name.localeCompare(b.name));
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Vendors",
    numberOfItems: vendors.length,
    itemListElement: vendors.map((v, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: new URL(paths.vendor(v), Astro.site).href,
      name: v.name,
    })),
  },
];
---

<BaseLayout
  title="Firmware by vendor"
  description={`Firmware published by ${plural(vendors.length, "vendor")} that sell Dahua-made devices, including ${vendors
    .slice(0, 4)
    .map((v) => v.name)
    .join(", ")}.`}
  jsonLd={jsonLd}
  lastmod={lastmodOf(data.firmwareList)}
  breadcrumbs={[{ name: "Home", href: "/" }, { name: "Vendors" }]}
>
  <PageHeader title="Vendors">
    <p class="mt-3 max-w-3xl text-muted">
      Dahua makes devices for many brands. These are the vendors whose download pages this site tracks. Pick one to see
      the firmware it publishes and the model names it uses.
    </p>
  </PageHeader>

  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      vendors.map((v) => (
        <li>
          <a
            href={paths.vendor(v)}
            class="card flex h-full items-center gap-4 p-4 text-fg no-underline hover:border-accent hover:no-underline"
          >
            <VendorLogo brand={v.brand} name={v.name} height={32} />
            <span class="min-w-0">
              <span class="block font-semibold">{v.name}</span>
              <span class="block text-xs text-muted">
                {plural(v.firmwares.length, "firmware file")}
                {v.models.length > 0 && ` · ${plural(v.models.length, "model")}`}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
