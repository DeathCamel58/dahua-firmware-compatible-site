---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Search from "@/components/Search.astro";
import VendorLogo from "@/components/VendorLogo.astro";
import { getData, lastmodOf, paths } from "@/lib/data";
import { composeDescription, plural } from "@/lib/site";

const data = await getData();
// Vendors that list retail models, biggest first. Each links to its own model index.
const vendors = [...data.vendors.values()]
  .filter((v) => v.models.length > 0)
  .sort((a, b) => b.models.length - a.models.length || a.name.localeCompare(b.name));
---

<BaseLayout
  title="Firmware by retail model"
  description={composeDescription([
    `Find firmware by the model name on the box: ${plural(data.models.size, "retail model")} from ${plural(vendors.length, "vendor")}`,
    { lead: "Including", items: vendors.map((v) => v.name) },
  ])}
  lastmod={lastmodOf(data.firmwareList)}
  breadcrumbs={[{ name: "Home", href: "/" }, { name: "Retail models" }]}
>
  <PageHeader title="Retail models">
    <p class="mt-3 max-w-3xl text-muted">
      The model names brands print on the box and use on their download pages. Search for yours, or pick the brand
      that sold it. If you only know your device's internal ID (its <code>updateSerial</code>),{" "}
      <a href="/device/">browse devices</a> instead.
    </p>
  </PageHeader>

  <div class="mb-8 max-w-2xl">
    <Search id="model-search" />
  </div>

  <h2 class="section-title">Browse by brand</h2>
  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      vendors.map((v) => (
        <li>
          <a
            href={paths.modelBrand(v)}
            class="card flex h-full items-center gap-4 p-4 text-fg no-underline hover:border-accent hover:no-underline"
          >
            <VendorLogo brand={v.brand} name={v.name} height={28} />
            <span class="min-w-0">
              <span class="block font-semibold">{v.name}</span>
              <span class="block text-xs text-muted">{plural(v.models.length, "model")}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
