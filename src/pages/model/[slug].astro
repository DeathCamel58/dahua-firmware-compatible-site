---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Chips from "@/components/Chips.astro";
import FirmwareList from "@/components/FirmwareList.astro";
import PageHeader from "@/components/PageHeader.astro";
import Stats from "@/components/Stats.astro";
import VendorLogo from "@/components/VendorLogo.astro";
import { collect, formatDate, getData, lastmodOf, paths } from "@/lib/data";
import { composeDescription, plural } from "@/lib/site";

export const getStaticPaths = (async () => {
  const data = await getData();
  return [...data.models.values()].map((model) => ({
    params: { slug: model.slug },
    props: { name: model.name },
  }));
}) satisfies GetStaticPaths;

const data = await getData();
const model = data.models.get(Astro.props.name)!;
const firmwares = model.firmwares.map((filename) => data.firmwares.get(filename)!);
const newest = firmwares.find((fw) => fw.date);
// Notes from the listings that actually name this model (other vendors' notes may be about other SKUs).
const notes = [
  ...new Set(firmwares.flatMap((fw) => fw.listings.filter((l) => l.models.includes(model.name)).flatMap((l) => l.notes))),
];
const vendors = model.publishers.map((name) => data.vendors.get(name)!).filter(Boolean);
const devices = collect(data, model.firmwares, (fw) => fw.devices)
  .map((name) => data.devices.get(name)!)
  .slice(0, 48);

// Prefix the brand when the model is only listed by one, e.g. "Amcrest IP8M-2493EW-AI-V3".
const brand = model.publishers.length === 1 ? model.publishers[0] : null;
const fullName = brand && !model.name.toUpperCase().startsWith(brand.toUpperCase()) ? `${brand} ${model.name}` : model.name;
const listedBy = model.publishers.length > 0 ? model.publishers.join(" and ") : "Its download source";

// A "model" that is just a vendor's name (seen in some listings) would clash with that vendor's page.
const clashesWithVendor = [...data.vendors.keys()].some((v) => v.toLowerCase() === model.name.toLowerCase());
const pageTitle = clashesWithVendor ? `${model.name} (listed as a model) firmware` : `${fullName} firmware`;
const description = composeDescription([
  `${fullName} firmware: ${plural(firmwares.length, "file")}`,
  newest && (newest.version ? `Newest ${newest.version} (${formatDate(newest.date)})` : `Updated ${formatDate(newest.date)}`),
  { lead: "Runs on Dahua hardware", items: devices.map((d) => d.name) },
  "Download links and archived copies",
]);
---

<BaseLayout
  title={pageTitle}
  description={description}
  lastmod={lastmodOf(firmwares)}
  breadcrumbs={[{ name: "Home", href: "/" }, { name: "Retail models", href: "/model/" }, { name: model.name }]}
>
  {
    vendors.length > 0 && (
      <div class="mb-3 flex flex-wrap gap-2">
        {vendors.map((v) => (
          <a href={paths.vendor(v)} class="no-underline hover:no-underline" title={`${v.name} firmware`}>
            <VendorLogo brand={v.brand} name={v.name} height={22} />
          </a>
        ))}
      </div>
    )
  }
  <PageHeader eyebrow={brand ? `${brand} model` : "Retail model"} title={model.name} mono copyable>
    <p class="mt-3 max-w-3xl text-muted">
      {listedBy} lists {plural(firmwares.length, "firmware file")} for the <strong class="text-fg">{model.name}</strong>.
      This is the retail model name. Inside the firmware, Dahua uses its own device IDs, listed below, which can lead you
      to more compatible firmware.
    </p>
  </PageHeader>

  <Stats
    stats={[
      { label: "Firmware files", value: firmwares.length },
      { label: "Newest", value: formatDate(newest?.date ?? null) },
      { label: "Listed by", value: model.publishers.join(", ") || null },
      { label: "Dahua device IDs", value: devices.length || null },
    ]}
  />

  {
    notes.length > 0 && (
      <section class="mb-8" aria-labelledby="notes-heading">
        <h2 id="notes-heading" class="section-title">Vendor notes</h2>
        <ul class="card list-inside list-disc space-y-1 p-5 text-sm">
          {notes.map((note) => <li>{note}</li>)}
        </ul>
      </section>
    )
  }

  <section class="mb-8" aria-labelledby="firmware-heading">
    <h2 id="firmware-heading" class="section-title">Firmware</h2>
    <FirmwareList firmwares={firmwares} />
  </section>

  {
    devices.length > 0 && (
      <section aria-labelledby="devices-heading">
        <h2 id="devices-heading" class="section-title">Dahua device IDs in this firmware</h2>
        <p class="mb-3 text-sm text-muted">
          Compare these with the <code>updateSerial</code> your device reports. Each one links to every firmware found
          for that ID.
        </p>
        <Chips items={devices.map((d) => ({ name: d.name, href: paths.device(d) }))} />
      </section>
    )
  }
</BaseLayout>
