---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getData, lastmodOf, paths } from "@/lib/data";
import { composeDescription, plural } from "@/lib/site";

const data = await getData();
// Most devices first: the platforms people are likeliest to be looking for.
const platforms = [...data.platforms.values()].sort(
  (a, b) => b.devices.length - a.devices.length || a.label.localeCompare(b.label),
);
const deviceCount = platforms.reduce((n, p) => n + p.devices.length, 0);
---

<BaseLayout
  title="Firmware platforms"
  description={composeDescription([
    `${plural(platforms.length, "firmware platform")} shared by ${plural(deviceCount, "Dahua-made device")}, each with its full firmware list`,
    { lead: "Including", items: platforms.map((p) => p.name).filter((name, i, all) => all.indexOf(name) === i) },
  ])}
  lastmod={lastmodOf(platforms.flatMap((p) => p.firmwares.slice(0, 1)).map((f) => data.firmwares.get(f)!))}
  breadcrumbs={[{ name: "Home", href: "/" }, { name: "Platforms" }]}
>
  <PageHeader title="Firmware platforms">
    <p class="mt-3 max-w-3xl text-muted">
      Many devices run exactly the same firmware: the same files list every one of them. Each platform here is a group
      of at least three such devices, with the full list of files they share. {plural(deviceCount, "device")} belong
      to one.
    </p>
  </PageHeader>

  <ul class="grid gap-2 sm:grid-cols-2">
    {
      platforms.map((p) => (
        <li>
          <a href={paths.platform(p)} class="card block px-4 py-3 no-underline hover:border-accent hover:no-underline">
            <span class="block font-mono text-sm break-all text-fg">{p.label}</span>
            <span class="block text-xs text-muted">
              {plural(p.devices.length, "device")} · {plural(p.firmwares.length, "file")} · e.g. {p.devices.slice(0, 3).join(", ")}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
