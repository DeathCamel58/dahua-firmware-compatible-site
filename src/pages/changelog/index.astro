---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { CATEGORY_LABELS, changelogAnchor, getChangelog } from "@/lib/changelog";
import { formatDate } from "@/lib/data";

const entries = await getChangelog();
const rendered = await Promise.all(entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
---

<BaseLayout
  title="Changelog"
  description="What's new and what changed on Dahua Firmware Finder: new features, new vendors and data sources, more firmware metadata, and fixes."
  lastmod={entries[0]?.data.date}
  breadcrumbs={[{ name: "Home", href: "/" }, { name: "Changelog" }]}
>
  <PageHeader title="Changelog">
    <p class="mt-3 max-w-3xl text-muted">
      Notes on what's new or changed on the site and in its data. Follow along with the{" "}
      <a href="/changelog/feed.xml">changelog RSS feed</a>. Individual new firmware files are listed automatically on{" "}
      <a href="/new/">Newly added</a>.
    </p>
  </PageHeader>

  {
    rendered.length === 0 ? (
      <p class="card p-6 text-muted">No entries yet.</p>
    ) : (
      <ol class="relative space-y-6 border-l border-border pl-6">
        {rendered.map(({ entry, Content }) => (
          <li id={changelogAnchor(entry)} class="scroll-mt-24">
            <span class="absolute -left-[5px] mt-2 h-2.5 w-2.5 rounded-full bg-accent" aria-hidden="true" />
            <article class="card p-5">
              <header class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <time datetime={entry.data.date} class="text-sm text-muted">
                  {formatDate(entry.data.date)}
                </time>
                <span
                  class:list={[
                    "rounded px-1.5 py-0.5 text-xs font-medium",
                    entry.data.category === "fix" ? "bg-warn-soft text-warn" : "bg-accent-soft text-accent",
                  ]}
                >
                  {CATEGORY_LABELS[entry.data.category]}
                </span>
                <a href={`#${changelogAnchor(entry)}`} class="text-xs text-muted no-underline hover:text-accent" aria-label="Link to this entry">
                  #
                </a>
              </header>
              <h2 class="mt-2 text-xl font-semibold">{entry.data.title}</h2>
              <div class="changelog-body mt-3 text-fg/90">
                <Content />
              </div>
            </article>
          </li>
        ))}
      </ol>
    )
  }
</BaseLayout>

<style>
  /* Markdown body: there's no typography plugin, so style the few elements entries use. */
  .changelog-body :global(* + p),
  .changelog-body :global(ul),
  .changelog-body :global(ol),
  .changelog-body :global(h3) {
    margin-top: 0.75rem;
  }
  .changelog-body :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .changelog-body :global(ol) {
    list-style: decimal;
    padding-left: 1.25rem;
  }
  .changelog-body :global(li + li) {
    margin-top: 0.25rem;
  }
  .changelog-body :global(h3) {
    font-weight: 600;
  }
  .changelog-body :global(code) {
    border-radius: 0.25rem;
    background: var(--color-surface-2);
    padding: 0.05rem 0.3rem;
  }
</style>
