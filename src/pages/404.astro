---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Search from "@/components/Search.astro";
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex hideHeaderSearch>
  <div class="mx-auto max-w-2xl py-12 text-center">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-2 text-3xl font-bold">Page not found</h1>
    <p class="mt-3 text-muted">
      The page may have moved since the site was redesigned. Search for your device or firmware instead.
    </p>
    <div class="mt-8 text-left">
      <Search id="notfound-search" />
    </div>
    <p class="mt-6 text-sm">
      <a href="/">Home</a> · <a href="/device/">Devices</a> · <a href="/firmware/">Firmware</a> ·
      <a href="/amcrest/">Amcrest models</a>
    </p>
  </div>
</BaseLayout>
