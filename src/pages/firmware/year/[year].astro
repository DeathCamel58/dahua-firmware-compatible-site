---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FirmwareList from "@/components/FirmwareList.astro";
import PageHeader from "@/components/PageHeader.astro";
import { UNDATED, firmwaresByYear, getData, lastmodOf, paths } from "@/lib/data";
import { plural } from "@/lib/site";

export const getStaticPaths = (async () => {
  const data = await getData();
  const years = firmwaresByYear(data);
  return years.map(({ year }, i) => ({
    params: { year },
    props: { year, newer: years[i - 1]?.year, older: years[i + 1]?.year },
  }));
}) satisfies GetStaticPaths;

const { year, newer, older } = Astro.props;
const data = await getData();
const firmwares = firmwaresByYear(data).find((group) => group.year === year)!.firmwares;
const label = (y: string) => (y === UNDATED ? "Undated" : y);

const title = year === UNDATED ? "Undated firmware files" : `Firmware from ${year}`;
const description =
  year === UNDATED
    ? `${plural(firmwares.length, "firmware file")} with no known release or build date, with download links and compatible devices.`
    : `${plural(firmwares.length, "Dahua, Amcrest and Lorex firmware file")} from ${year}, newest first, with download links and compatible devices.`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: title,
    numberOfItems: firmwares.length,
    itemListElement: firmwares.slice(0, 100).map((fw, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: new URL(paths.firmware(fw), Astro.site).href,
      name: fw.title,
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  lastmod={lastmodOf(firmwares)}
  breadcrumbs={[{ name: "Home", href: "/" }, { name: "Firmware", href: "/firmware/" }, { name: label(year) }]}
>
  <PageHeader title={title}>
    <p class="mt-3 text-muted">{description}</p>
  </PageHeader>

  <FirmwareList firmwares={firmwares} />

  <nav aria-label="Years" class="mt-6 flex justify-between gap-4 text-sm">
    {newer ? <a href={`/firmware/year/${newer}/`} class="btn-ghost">← {label(newer)}</a> : <span />}
    {older && <a href={`/firmware/year/${older}/`} class="btn-ghost">{label(older)} →</a>}
  </nav>
</BaseLayout>
