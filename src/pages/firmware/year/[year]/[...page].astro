---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FirmwareList from "@/components/FirmwareList.astro";
import Pager from "@/components/Pager.astro";
import PageHeader from "@/components/PageHeader.astro";
import { UNDATED, firmwaresByYear, getData, lastmodOf, paths } from "@/lib/data";
import { plural } from "@/lib/site";
import { FIRMWARE_PAGE_SIZE, pageOf, pageParams, pageSuffix } from "@/lib/paginate";

export const getStaticPaths = (async () => {
  const data = await getData();
  const years = firmwaresByYear(data);
  return years.flatMap(({ year, firmwares }, i) =>
    pageParams(firmwares.length, FIRMWARE_PAGE_SIZE).map(({ page, number }) => ({
      params: { year, page },
      props: { year, page: number, newer: years[i - 1]?.year, older: years[i + 1]?.year },
    })),
  );
}) satisfies GetStaticPaths;

const { year, page, newer, older } = Astro.props;
const data = await getData();
const firmwares = firmwaresByYear(data).find((group) => group.year === year)!.firmwares;
const label = (y: string) => (y === UNDATED ? "Undated" : y);
const list = pageOf(firmwares, page, FIRMWARE_PAGE_SIZE);
const yearUrl = `/firmware/year/${year}/`;

const baseTitle = year === UNDATED ? "Undated firmware files" : `Firmware from ${year}`;
const title = `${baseTitle}${pageSuffix(list.page, list.pages)}`;
const description =
  year === UNDATED
    ? `${plural(firmwares.length, "firmware file")} with no known release or build date, with download links and compatible devices.`
    : `${plural(firmwares.length, "firmware file")} for Dahua-made devices from ${year}, newest first, with download links and compatible devices.`;
const pageNote = list.pages > 1 ? ` Showing ${list.from}–${list.to}.` : "";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: title,
    numberOfItems: firmwares.length,
    itemListElement: list.items.map((fw, i) => ({
      "@type": "ListItem",
      position: list.from + i,
      url: new URL(paths.firmware(fw), Astro.site).href,
      name: fw.title,
    })),
  },
];
---

<BaseLayout
  title={title}
  description={`${description}${pageNote}`}
  jsonLd={jsonLd}
  lastmod={lastmodOf(list.items)}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Firmware", href: "/firmware/" },
    list.page === 1 ? { name: label(year) } : { name: label(year), href: yearUrl },
    ...(list.page === 1 ? [] : [{ name: `Page ${list.page}` }]),
  ]}
>
  <PageHeader title={title}>
    <p class="mt-3 text-muted">{description}{pageNote}</p>
  </PageHeader>

  <FirmwareList firmwares={list.items} />
  <Pager page={list.page} pages={list.pages} base={yearUrl} />

  <nav aria-label="Years" class="mt-6 flex justify-between gap-4 text-sm">
    {newer ? <a href={`/firmware/year/${newer}/`} class="btn-ghost">← {label(newer)}</a> : <span />}
    {older && <a href={`/firmware/year/${older}/`} class="btn-ghost">{label(older)} →</a>}
  </nav>
</BaseLayout>
