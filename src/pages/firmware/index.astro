---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FirmwareList from "@/components/FirmwareList.astro";
import PageHeader from "@/components/PageHeader.astro";
import { UNDATED, firmwaresByYear, getData } from "@/lib/data";
import { plural } from "@/lib/site";

const data = await getData();
const years = firmwaresByYear(data);
const newest = data.firmwareList.slice(0, 25);

const vendors = new Map<string, number>();
for (const fw of data.firmwareList) {
  const vendor = fw.vendor ?? "Unknown";
  vendors.set(vendor, (vendors.get(vendor) ?? 0) + 1);
}
const vendorList = [...vendors].sort((a, b) => b[1] - a[1]);

const yearLabel = (year: string) => (year === UNDATED ? "Undated" : year);
---

<BaseLayout
  title="All Dahua, Amcrest & Lorex firmware files"
  description={`Browse ${plural(data.firmwareList.length, "firmware file")} for Dahua-made cameras, NVRs and DVRs (including Amcrest and Lorex), by build year, with download links and compatible devices.`}
  breadcrumbs={[{ name: "Home", href: "/" }, { name: "Firmware" }]}
>
  <PageHeader title="Firmware files">
    <p class="mt-3 max-w-3xl text-muted">
      {plural(data.firmwareList.length, "firmware file")} from Dahua and its OEMs, organised by build year. Open a file
      to see which devices it may support.
    </p>
  </PageHeader>

  <section class="mb-10" aria-labelledby="years-heading">
    <h2 id="years-heading" class="section-title">Browse by build year</h2>
    <ul class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6">
      {
        years.map(({ year, firmwares }) => (
          <li>
            <a
              href={`/firmware/year/${year}/`}
              class="card block px-4 py-3 text-fg no-underline hover:border-accent hover:no-underline"
            >
              <span class="block text-lg font-semibold">{yearLabel(year)}</span>
              <span class="text-xs text-muted">{plural(firmwares.length, "file")}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-10" aria-labelledby="newest-heading">
    <h2 id="newest-heading" class="section-title">Newest builds</h2>
    <FirmwareList firmwares={newest} />
  </section>

  <section aria-labelledby="vendors-heading">
    <h2 id="vendors-heading" class="section-title">By vendor (from the filename)</h2>
    <ul class="flex flex-wrap gap-2 text-sm">
      {
        vendorList.map(([vendor, count]) => (
          <li class="rounded-md border border-border bg-surface px-3 py-1">
            {vendor} <span class="text-muted">· {count.toLocaleString("en-US")}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
