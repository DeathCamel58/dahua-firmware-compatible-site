---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FirmwareList from "@/components/FirmwareList.astro";
import PageHeader from "@/components/PageHeader.astro";
import VendorLogo from "@/components/VendorLogo.astro";
import { UNDATED, firmwaresByYear, getData, lastmodOf, paths } from "@/lib/data";
import { plural } from "@/lib/site";

const data = await getData();
const years = firmwaresByYear(data);
const newest = data.firmwareList.slice(0, 25);

const vendorList = [...data.vendors.values()].sort((a, b) => b.firmwares.length - a.firmwares.length);

const yearLabel = (year: string) => (year === UNDATED ? "Undated" : year);
---

<BaseLayout
  title="All firmware for Dahua-made devices"
  description={`Browse ${plural(data.firmwareList.length, "firmware file")} for Dahua-made cameras, NVRs and DVRs from ${data.vendors.size} brands, by year, with download links and compatible devices.`}
  lastmod={lastmodOf(data.firmwareList)}
  breadcrumbs={[{ name: "Home", href: "/" }, { name: "Firmware" }]}
>
  <PageHeader title="Firmware files">
    <p class="mt-3 max-w-3xl text-muted">
      {plural(data.firmwareList.length, "firmware file")} from Dahua and its OEMs, organised by year. Open a file
      to see which devices it may support.
    </p>
  </PageHeader>

  <section class="mb-10" aria-labelledby="years-heading">
    <h2 id="years-heading" class="section-title">Browse by year</h2>
    <ul class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6">
      {
        years.map(({ year, firmwares }) => (
          <li>
            <a
              href={`/firmware/year/${year}/`}
              class="card block px-4 py-3 text-fg no-underline hover:border-accent hover:no-underline"
            >
              <span class="block text-lg font-semibold">{yearLabel(year)}</span>
              <span class="text-xs text-muted">{plural(firmwares.length, "file")}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-10" aria-labelledby="newest-heading">
    <h2 id="newest-heading" class="section-title">Newest firmware</h2>
    <FirmwareList firmwares={newest} />
  </section>

  <section aria-labelledby="vendors-heading">
    <h2 id="vendors-heading" class="section-title">By vendor</h2>
    <ul class="flex flex-wrap gap-3">
      {
        vendorList.map((vendor) => (
          <li>
            <a href={paths.vendor(vendor)} class="card flex items-center gap-3 px-3 py-2 text-sm text-fg no-underline hover:border-accent hover:no-underline">
              <VendorLogo brand={vendor.brand} name={vendor.name} height={20} />
              <span>
                {vendor.name} <span class="text-muted">· {vendor.firmwares.length.toLocaleString("en-US")}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
