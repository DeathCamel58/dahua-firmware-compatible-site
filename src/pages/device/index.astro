---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getData, paths } from "@/lib/data";
import { plural } from "@/lib/site";

const data = await getData();
const families = [...data.families.values()].sort((a, b) => {
  // "Other" goes last; the rest are biggest first.
  if (a.name === "Other") return 1;
  if (b.name === "Other") return -1;
  return b.devices.length - a.devices.length || a.name.localeCompare(b.name);
});
---

<BaseLayout
  title="Dahua device families"
  description={`Browse ${plural(data.devices.size, "Dahua device ID")} across ${families.length} families (IPC-HFW, IPC-HDBW, NVR, XVR, SD and more) to find firmware that may be compatible.`}
  breadcrumbs={[{ name: "Home", href: "/" }, { name: "Devices" }]}
>
  <PageHeader title="Devices by family">
    <p class="mt-3 max-w-3xl text-muted">
      {plural(data.devices.size, "device ID")} found inside firmware files, grouped by model prefix. Not sure of your
      model? Check your device's <a href="/#how-to"><code>updateSerial</code></a>.
    </p>
  </PageHeader>

  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      families.map((family) => (
        <li>
          <a
            href={paths.family(family)}
            class="card flex h-full flex-col px-4 py-3 text-fg no-underline hover:border-accent hover:no-underline"
          >
            <span class="flex items-baseline justify-between gap-2">
              <span class="font-mono font-semibold">{family.name}</span>
              <span class="text-xs text-muted">{plural(family.devices.length, "device")}</span>
            </span>
            <span class="mt-1 truncate font-mono text-xs text-muted">{family.devices.slice(0, 4).join(", ")}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
