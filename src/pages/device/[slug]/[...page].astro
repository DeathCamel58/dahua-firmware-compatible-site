---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Chips from "@/components/Chips.astro";
import Pager from "@/components/Pager.astro";
import FirmwareList from "@/components/FirmwareList.astro";
import PageHeader from "@/components/PageHeader.astro";
import Stats from "@/components/Stats.astro";
import Redirect from "@/components/Redirect.astro";
import { collect, deviceCategory, formatDate, getData, lastmodOf, paths, retailNames, similarDevices } from "@/lib/data";
import { composeDescription, plural } from "@/lib/site";
import { FIRMWARE_PAGE_SIZE, pageOf, pageParams, pageSuffix, pageUrl } from "@/lib/paginate";

/** Files shown on a device page whose full list lives on its platform page. */
const PLATFORM_PREVIEW = 5;

export const getStaticPaths = (async () => {
  const data = await getData();
  // Long lists (a board family like IPC-HX3XXX has hundreds of files) are split into pages:
  // /device/<slug>/, then /device/<slug>/2/… A device on a shared platform keeps only its first page; its
  // later pages, which may already be indexed, redirect to the same page of the platform's list.
  return [...data.devices.values()].flatMap((device) => {
    const platform = device.platformSlug ? data.platforms.get(device.platformSlug)! : null;
    return pageParams(device.firmwares.length, FIRMWARE_PAGE_SIZE).map(({ page, number }) => ({
      params: { slug: device.slug, page },
      props: { name: device.name, page: number, redirect: platform && number > 1 ? pageUrl(paths.platform(platform), number) : null },
    }));
  });
}) satisfies GetStaticPaths;

const data = await getData();
const device = data.devices.get(Astro.props.name)!;
const platform = device.platformSlug ? data.platforms.get(device.platformSlug)! : null;
const firmwares = device.firmwares.map((filename) => data.firmwares.get(filename)!);
const list = platform
  ? pageOf(firmwares, 1, PLATFORM_PREVIEW)
  : pageOf(firmwares, Astro.props.page, FIRMWARE_PAGE_SIZE);
const first = list.page === 1;
const newest = firmwares.find((fw) => fw.date);
const vendors = collect(data, device.firmwares, (fw) => fw.vendors);
const chips = collect(data, device.firmwares, (fw) => fw.socs.map((s) => s.name)).map((name) => data.socs.get(name)!);
const similar = similarDevices(data, device);
const models = collect(data, device.firmwares, (fw) => fw.models)
  .slice(0, 24)
  .map((name) => data.models.get(name)!);

const description = composeDescription([
  // Later pages put the page number in the opening sentence, which is always kept, so each is unique.
  first
    ? `${device.name} firmware: ${plural(firmwares.length, "file")}${vendors.length ? ` from ${vendors.join(", ")}` : ""}`
    : `${device.name} firmware, page ${list.page} of ${list.pages}: files ${list.from}–${list.to} of ${list.total}`,
  newest && (newest.version ? `Newest ${newest.version} (${formatDate(newest.date)})` : `Updated ${formatDate(newest.date)}`),
  { lead: "Same hardware sold as", items: retailNames(firmwares) },
  "Download links and archived copies",
]);
const site = Astro.site!;
const category = deviceCategory(device);
const jsonLd = [
  // The hardware itself, described once, on its main page.
  ...(first
    ? [
        {
          "@context": "https://schema.org",
          "@type": "ProductModel",
          name: device.name,
          ...(category ? { category } : {}),
          manufacturer: { "@type": "Organization", name: "Dahua Technology" },
          url: new URL(paths.device(device), site).href,
          description,
        },
      ]
    : []),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: `${device.name} firmware`,
    numberOfItems: list.total,
    itemListElement: list.items.map((fw, i) => ({
      "@type": "ListItem",
      position: list.from + i,
      url: new URL(paths.firmware(fw), site).href,
      name: fw.title,
    })),
  },
];
---

{Astro.props.redirect ? <Redirect to={Astro.props.redirect} /> : (
<BaseLayout
  title={`${device.name} firmware downloads${pageSuffix(list.page, list.pages)}`}
  description={description}
  jsonLd={jsonLd}
  lastmod={lastmodOf(list.items)}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Devices", href: "/device/" },
    { name: device.family, href: paths.family({ slug: device.familySlug }) },
    first ? { name: device.name } : { name: device.name, href: paths.device(device) },
    ...(first ? [] : [{ name: `Page ${list.page}` }]),
  ]}
>
  <PageHeader eyebrow={device.kind === "board" ? "Board family" : "Device"} title={device.name} mono copyable="device_name">
    <p class="mt-3 max-w-3xl text-muted">
      {plural(firmwares.length, "firmware file")} may be compatible with the <strong class="text-fg">{device.name}</strong>.
      Part of the <a href={paths.family({ slug: device.familySlug })}>{device.family}</a> family.{" "}
      {platform ? (
        <>
          It shares this exact list with {plural(platform.devices.length - 1, "other device")} on the{" "}
          <a href={paths.platform(platform)}>{platform.label}</a> platform.
        </>
      ) : (
        "The newest builds are listed first."
      )}
      {device.kind === "board" && " This is a board family name: the x or XXX placeholders stand for several specific models."}
    </p>
  </PageHeader>

  {first && (<Stats
    stats={[
      { label: "Firmware files", value: firmwares.length },
      { label: "Newest", value: formatDate(newest?.date ?? null) },
      { label: "Family", value: device.family },
      { label: "Vendors", value: vendors.join(", ") || null },
      { label: "Chip", value: chips.map((c) => c.name).join(", ") || null },
    ]}
  />)}


  <section class="mb-8" aria-labelledby="firmware-heading">
    <h2 id="firmware-heading" class="section-title">{platform ? "Newest compatible firmware" : "Compatible firmware"}</h2>
    {!platform && list.pages > 1 && (
      <p class="mb-3 text-sm text-muted">
        Showing {list.from}–{list.to} of {list.total.toLocaleString("en-US")}, newest first.
      </p>
    )}
    <FirmwareList firmwares={list.items} />
    {platform ? (
      <p class="mt-4">
        <a href={paths.platform(platform)} class="btn-primary no-underline">
          All {firmwares.length.toLocaleString("en-US")} files on the {platform.name} platform page
        </a>
      </p>
    ) : (
      <Pager page={list.page} pages={list.pages} base={paths.device(device)} />
    )}
    <p class="mt-3 text-sm text-muted">
      Compatibility is detected automatically from firmware files and may be incomplete or wrong. Always confirm your
      device's <code>updateSerial</code> first.
    </p>
  </section>

  {
    !platform && first && similar.length > 0 && (
      <section class="mb-8" aria-labelledby="similar-heading">
        <h2 id="similar-heading" class="section-title">Devices sharing firmware with the {device.name}</h2>
        <Chips items={similar.map((d) => ({ name: d.name, href: paths.device(d) }))} />
      </section>
    )
  }

  {
    !platform && first && models.length > 0 && (
      <section aria-labelledby="models-heading">
        <h2 id="models-heading" class="section-title">Retail models using the same firmware</h2>
        <Chips items={models.map((m) => ({ name: m.name, href: paths.model(m) }))} />
      </section>
    )
  }
</BaseLayout>
)}
