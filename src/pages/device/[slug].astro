---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Chips from "@/components/Chips.astro";
import FirmwareList from "@/components/FirmwareList.astro";
import PageHeader from "@/components/PageHeader.astro";
import Stats from "@/components/Stats.astro";
import { collect, formatDate, getData, lastmodOf, paths, retailNames, similarDevices } from "@/lib/data";
import { composeDescription, plural } from "@/lib/site";

export const getStaticPaths = (async () => {
  const data = await getData();
  return [...data.devices.values()].map((device) => ({
    params: { slug: device.slug },
    props: { name: device.name },
  }));
}) satisfies GetStaticPaths;

const data = await getData();
const device = data.devices.get(Astro.props.name)!;
const firmwares = device.firmwares.map((filename) => data.firmwares.get(filename)!);
const newest = firmwares.find((fw) => fw.date);
const vendors = collect(data, device.firmwares, (fw) => fw.vendors);
const similar = similarDevices(data, device);
const models = collect(data, device.firmwares, (fw) => fw.models)
  .slice(0, 24)
  .map((name) => data.models.get(name)!);

const description = composeDescription([
  `${device.name} firmware: ${plural(firmwares.length, "file")}${vendors.length ? ` from ${vendors.join(", ")}` : ""}`,
  newest && (newest.version ? `Newest ${newest.version} (${formatDate(newest.date)})` : `Updated ${formatDate(newest.date)}`),
  { lead: "Same hardware sold as", items: retailNames(firmwares) },
  "Download links and archived copies",
]);
---

<BaseLayout
  title={`${device.name} firmware downloads`}
  description={description}
  lastmod={lastmodOf(firmwares)}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Devices", href: "/device/" },
    { name: device.family, href: paths.family({ slug: device.familySlug }) },
    { name: device.name },
  ]}
>
  <PageHeader eyebrow={device.kind === "board" ? "Board family" : "Device"} title={device.name} mono copyable>
    <p class="mt-3 max-w-3xl text-muted">
      {plural(firmwares.length, "firmware file")} may be compatible with the <strong class="text-fg">{device.name}</strong>.
      Part of the <a href={paths.family({ slug: device.familySlug })}>{device.family}</a> family. The newest builds are
      listed first.
      {device.kind === "board" && " This is a board family name: the x or XXX placeholders stand for several specific models."}
    </p>
  </PageHeader>

  <Stats
    stats={[
      { label: "Firmware files", value: firmwares.length },
      { label: "Newest", value: formatDate(newest?.date ?? null) },
      { label: "Family", value: device.family },
      { label: "Vendors", value: vendors.join(", ") || null },
    ]}
  />


  <section class="mb-8" aria-labelledby="firmware-heading">
    <h2 id="firmware-heading" class="section-title">Compatible firmware</h2>
    <FirmwareList firmwares={firmwares} />
    <p class="mt-3 text-sm text-muted">
      Compatibility is detected automatically from firmware files and may be incomplete or wrong. Always confirm your
      device's <code>updateSerial</code> first.
    </p>
  </section>

  {
    similar.length > 0 && (
      <section class="mb-8" aria-labelledby="similar-heading">
        <h2 id="similar-heading" class="section-title">Devices sharing firmware with the {device.name}</h2>
        <Chips items={similar.map((d) => ({ name: d.name, href: paths.device(d) }))} />
      </section>
    )
  }

  {
    models.length > 0 && (
      <section aria-labelledby="models-heading">
        <h2 id="models-heading" class="section-title">Retail models using the same firmware</h2>
        <Chips items={models.map((m) => ({ name: m.name, href: paths.model(m) }))} />
      </section>
    )
  }
</BaseLayout>
