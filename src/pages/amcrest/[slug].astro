---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Chips from "@/components/Chips.astro";
import FirmwareList from "@/components/FirmwareList.astro";
import PageHeader from "@/components/PageHeader.astro";
import Stats from "@/components/Stats.astro";
import { collect, formatDate, getData, paths } from "@/lib/data";
import { plural } from "@/lib/site";

export const getStaticPaths = (async () => {
  const data = await getData();
  return [...data.amcrestModels.values()].map((model) => ({
    params: { slug: model.slug },
    props: { name: model.name },
  }));
}) satisfies GetStaticPaths;

const data = await getData();
const model = data.amcrestModels.get(Astro.props.name)!;
const firmwares = model.firmwares.map((filename) => data.firmwares.get(filename)!);
const newest = firmwares.find((fw) => fw.buildDate);
const notes = collect(data, model.firmwares, (fw) => fw.notes);
const devices = collect(data, model.firmwares, (fw) => fw.devices)
  .map((name) => data.devices.get(name)!)
  .filter((d) => !d.generic)
  .slice(0, 48);

const description =
  `Amcrest ${model.name} firmware: ${plural(firmwares.length, "file")}` +
  (newest ? `, newest built ${formatDate(newest.buildDate)}` : "") +
  ". Download links plus the Dahua device IDs the same firmware supports.";
---

<BaseLayout
  title={`Amcrest ${model.name} firmware`}
  description={description}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Amcrest models", href: "/amcrest/" },
    { name: model.name },
  ]}
>
  <PageHeader eyebrow="Amcrest model" title={model.name} mono copyable>
    <p class="mt-3 max-w-3xl text-muted">
      Amcrest lists {plural(firmwares.length, "firmware file")} for the <strong class="text-fg">{model.name}</strong>.
      Amcrest devices are made by Dahua, so the Dahua device IDs below can help you find more firmware.
    </p>
  </PageHeader>

  <Stats
    stats={[
      { label: "Firmware files", value: firmwares.length },
      { label: "Newest build", value: formatDate(newest?.buildDate ?? null) },
      { label: "Dahua device IDs", value: devices.length || null },
    ]}
  />

  {
    notes.length > 0 && (
      <section class="mb-8" aria-labelledby="notes-heading">
        <h2 id="notes-heading" class="section-title">Amcrest notes</h2>
        <ul class="card list-inside list-disc space-y-1 p-5 text-sm">
          {notes.map((note) => <li>{note}</li>)}
        </ul>
      </section>
    )
  }

  <section class="mb-8" aria-labelledby="firmware-heading">
    <h2 id="firmware-heading" class="section-title">Firmware</h2>
    <FirmwareList firmwares={firmwares} />
  </section>

  {
    devices.length > 0 && (
      <section aria-labelledby="devices-heading">
        <h2 id="devices-heading" class="section-title">Dahua device IDs in this firmware</h2>
        <p class="mb-3 text-sm text-muted">
          Compare these with the <code>updateSerial</code> your camera reports. Each one links to every firmware found
          for that ID.
        </p>
        <Chips items={devices.map((d) => ({ name: d.name, href: paths.device(d) }))} />
      </section>
    )
  }
</BaseLayout>
