---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Chips from "@/components/Chips.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getData, paths } from "@/lib/data";
import { plural } from "@/lib/site";

const data = await getData();

// Group by the leading letters of the model (IP, NV, AMDV, ASH, …) for scannable sections.
const groups = new Map<string, { name: string; href: string }[]>();
for (const model of data.amcrestModels.values()) {
  const key = model.name.match(/^[A-Za-z]+/)?.[0].toUpperCase() ?? "#";
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push({ name: model.name, href: paths.amcrest(model) });
}
const sorted = [...groups].sort(([a], [b]) => a.localeCompare(b));
---

<BaseLayout
  title="Amcrest firmware by model"
  description={`Find firmware for ${plural(data.amcrestModels.size, "Amcrest model")}, from IP cameras to NVRs and DVRs, plus the Dahua device IDs each file supports.`}
  breadcrumbs={[{ name: "Home", href: "/" }, { name: "Amcrest models" }]}
>
  <PageHeader title="Amcrest models">
    <p class="mt-3 max-w-3xl text-muted">
      Amcrest cameras and recorders are made by Dahua. Pick your retail model to see its firmware and the matching
      Dahua device IDs.
    </p>
  </PageHeader>

  <nav aria-label="Jump to prefix" class="mb-6 flex flex-wrap gap-1 text-sm">
    {sorted.map(([key]) => <a href={`#prefix-${key}`} class="rounded px-2 py-1 font-mono hover:bg-surface-2">{key}</a>)}
  </nav>

  <div class="space-y-8">
    {
      sorted.map(([key, models]) => (
        <section id={`prefix-${key}`} aria-labelledby={`prefix-${key}-heading`} class="scroll-mt-24">
          <h2 id={`prefix-${key}-heading`} class="section-title font-mono">
            {key} <span class="text-sm font-normal text-muted">({models.length})</span>
          </h2>
          <Chips items={models} />
        </section>
      ))
    }
  </div>
</BaseLayout>
