---
import { analysisLabel, formatDate, paths, type Firmware } from "@/lib/data";

interface Props {
  firmwares: Firmware[];
  /** Show a direct download button on each row. */
  showDownload?: boolean;
}

const { firmwares, showDownload = true } = Astro.props;
---

<ul class="card divide-y divide-border">
  {
    firmwares.map((fw) => {
      const meta = [
        fw.date && `${fw.dateSource === "vendor" ? "Released" : "Built"} ${formatDate(fw.date)}`,
        fw.version,
        analysisLabel(fw),
        fw.vendors.join(", "),
      ].filter(Boolean);
      return (
        <li class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:gap-4">
          <div class="min-w-0 flex-1">
            <a href={paths.firmware(fw)} class="font-mono text-sm break-all">
              {fw.displayName}
            </a>
            <p class="mt-1 text-xs text-muted">
              {fw.truncated && <span class="mr-1 rounded bg-warn-soft px-1.5 py-0.5 font-medium text-warn">Truncated</span>}
              {fw.platform === "hikvision" && (
                <span class="mr-1 rounded bg-surface-2 px-1.5 py-0.5 font-medium text-fg">Hikvision</span>
              )}
              {meta.join(" · ")}
            </p>
          </div>
          {showDownload && fw.download && !fw.truncated && (
            <a
              href={fw.download.url}
              class="btn-ghost shrink-0 self-start px-3 py-1.5 text-sm sm:self-center"
              rel="nofollow noopener"
              aria-label={`Download ${fw.displayName} from ${fw.download.label}`}
              title={`Download from ${fw.download.label}`}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 3v12m0 0-5-5m5 5 5-5M4 21h16" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Download
            </a>
          )}
        </li>
      );
    })
  }
</ul>
