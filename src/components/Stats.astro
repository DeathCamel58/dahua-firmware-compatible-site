---
interface Props {
  stats: { label: string; value: string | number | null | undefined }[];
}

const stats = Astro.props.stats.filter((stat) => stat.value !== null && stat.value !== undefined && stat.value !== "");
---

<dl class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
  {
    stats.map((stat) => (
      <div class="card px-4 py-3">
        <dt class="text-xs text-muted">{stat.label}</dt>
        <dd class="mt-1 font-mono text-sm font-semibold break-all sm:text-base">
          {typeof stat.value === "number" ? stat.value.toLocaleString("en-US") : stat.value}
        </dd>
      </div>
    ))
  }
</dl>
