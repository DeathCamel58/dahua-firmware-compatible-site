---
interface Props {
  title?: string;
}

const { title = "Flash at your own risk" } = Astro.props;
---

<aside class="rounded-xl border border-warn/40 bg-warn-soft px-4 py-3 text-sm" role="note">
  <p class="font-semibold text-warn">{title}</p>
  <div class="mt-1 text-fg/90"><slot /></div>
</aside>
