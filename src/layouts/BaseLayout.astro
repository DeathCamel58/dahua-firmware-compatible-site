---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumbs, { type Crumb } from "@/components/Breadcrumbs.astro";
import { GA_MEASUREMENT_ID, SITE_NAME, clampDescription } from "@/lib/site";

interface Props {
  /** Page-specific title; the site name is appended automatically. */
  title: string;
  description: string;
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD objects for this page. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** Hide the header search (e.g. on pages that render their own big search box). */
  hideHeaderSearch?: boolean;
  /** When the page's content last changed (YYYY-MM-DD); also feeds <lastmod> in the sitemap. */
  lastmod?: string | null;
  /** Open Graph type: "article" for single-item pages such as a firmware file. */
  ogType?: "website" | "article";
}

const { title, breadcrumbs, jsonLd = [], noindex = false, hideHeaderSearch = false, lastmod, ogType = "website" } = Astro.props;
const ogImage = new URL("/og-image.png", Astro.site).href;
// Only add the site name when the result still fits in a search result (~60 characters).
const withSite = `${title} | ${SITE_NAME}`;
const fullTitle = title === SITE_NAME || withSite.length > 60 ? title : withSite;
const description = clampDescription(Astro.props.description);
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const structuredData = [...jsonLd];
if (breadcrumbs && breadcrumbs.length > 0) {
  structuredData.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((crumb, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: crumb.name,
      ...(crumb.href ? { item: new URL(crumb.href, Astro.site).href } : {}),
    })),
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Newly added firmware" href="/feed.xml" />
    <link rel="alternate" type="application/rss+xml" title="Changelog" href="/changelog/feed.xml" />
    <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}: find firmware for Dahua-made devices`} />
    {lastmod && <meta property="og:updated_time" content={lastmod} />}
    <meta name="twitter:card" content="summary_large_image" />

    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    {
      /* Google tag (gtag.js). Production builds only, so local dev doesn't record visits.
         Automated browsers (navigator.webdriver, a headless user agent, or a square screen) are still
         recorded, but tagged traffic_type=bot so a GA4 data filter can exclude them. traffic_type has to be
         on the config call, or the page_view it sends goes out untagged.

         Square screens are the strongest bot signal in this property's data: 20,680 sessions across
         1366x1366 / 1280x1280 / 1600x1600 / 1024x1024, all at ~0.2% engagement and ~1s sessions (the
         1366x1366 crawler alone sent ~20.6k sessions from Singapore on 2026-10-08). Across 1,431 real
         sessions and 157 distinct resolutions, not one was square. The width > 0 guard matters: one
         genuine visitor reported 0x0 (screen API unavailable) and engaged normally.

         Don't extend this to other low-engagement traffic (e.g. the China crawl or the "Unassigned"
         channel on ordinary 1920x1080 Chrome): any rule that matches a normal desktop fingerprint
         mislabels real visitors. Those need an edge or server-side answer; see section 1 of the
         analytics spec. */
      import.meta.env.PROD && (
        <script
          is:inline
          set:html={`(function () {
  // Shim first, on every code path: event calls elsewhere on the page rely on gtag existing.
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () { dataLayer.push(arguments); };

  var s = window.screen || {};
  // Square screens: no real visitor has had one (see the comment in BaseLayout.astro).
  var squareViewport = s.width > 0 && s.width === s.height;
  var automated = navigator.webdriver === true ||
                  squareViewport ||
                  /HeadlessChrome|Headless|Puppeteer|Playwright|PhantomJS/i.test(navigator.userAgent);

  var t = document.createElement('script');
  t.async = true;
  t.src = 'https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}';
  document.head.appendChild(t);

  gtag('js', new Date());
  gtag('config', '${GA_MEASUREMENT_ID}', automated ? { traffic_type: 'bot' } : {});
})();`}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 btn-primary">
      Skip to content
    </a>
    <Header hideSearch={hideHeaderSearch} />
    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:px-6 sm:py-8">
      {breadcrumbs && <Breadcrumbs crumbs={breadcrumbs} />}
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { initClickTracking, track } from "@/scripts/analytics";

  initClickTracking();

  // Copy-to-clipboard buttons: <button data-copy="text" data-copy-kind="device_name|magicbox_url|…">
  document.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("[data-copy]");
    if (!button) return;
    // Only a label of what was copied: the text itself is unbounded (and could be an IP address).
    track("copy", { copied_content: button.dataset.copyKind });
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      const label = button.querySelector("[data-copy-label]");
      if (label) {
        const original = label.textContent;
        label.textContent = "Copied";
        setTimeout(() => (label.textContent = original), 1500);
      }
    } catch {
      // Clipboard unavailable (insecure context / permissions); nothing to do.
    }
  });
</script>
